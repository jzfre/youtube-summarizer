# OpenAI API key (required)
OPENAI_API_KEY=your-openai-api-key-here

# Host bind address and port (loopback by default; reverse proxy to this port)
BIND_ADDRESS=127.0.0.1
# Port to expose the service (default: 3000)
PORT=3000

# Shared password gating the web UI (required)
APP_PASSWORD=pick-a-password

# Secret used to sign session cookies (required).
# Generate one with: openssl rand -hex 32
AUTH_SECRET=change-me-to-a-long-random-string

# Use a model available to your API account/provider.
# OPENAI_MODEL=gpt-5.6-sol
# Optional OpenAI-compatible endpoint (omit for api.openai.com).
# OPENAI_BASE_URL=https://provider.example/v1

# Only true behind a proxy that overwrites X-Forwarded-For; block direct access.
TRUST_PROXY=false
# COOKIE_SECURE=false  # trusted plain-HTTP deployments only

PYTHON_TIMEOUT_MS=600000
PYTHON_MAX_CONCURRENT=4
PYTHON_MAX_OUTPUT_BYTES=4194304
