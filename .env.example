# OpenAI API Key (required)
OPENAI_API_KEY=your-openai-api-key-here

# Port to expose the service (default: 3000)
PORT=3000

# Shared password gating the web UI (default: sharing_with_friends)
APP_PASSWORD=sharing_with_friends

# Secret used to sign session cookies. Set to a random string in production.
AUTH_SECRET=change-me-to-a-long-random-string
