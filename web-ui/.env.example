# OpenAI API key (required)
OPENAI_API_KEY=your-openai-api-key-here

# Absolute paths to the Python CLI and interpreter (required)
PYTHON_CLI_PATH=/absolute/path/to/cli/youtube_summarizer.py
PYTHON_EXECUTABLE=/absolute/path/to/cli/venv/bin/python

# Shared password gating the web UI (required in production;
# defaults to "dev-password" in development)
APP_PASSWORD=pick-a-password

# Secret used to sign session cookies (required in production).
# Generate one with: openssl rand -hex 32
AUTH_SECRET=change-me-to-a-long-random-string

# Set a model supported by your OpenAI account/provider.
# OPENAI_MODEL=gpt-5.6-sol
# OPENAI_BASE_URL=https://provider.example/v1

# Enable only when a trusted proxy overwrites X-Forwarded-For.
TRUST_PROXY=false
# COOKIE_SECURE=false  # trusted plain-HTTP deployments only
PYTHON_TIMEOUT_MS=600000
PYTHON_MAX_CONCURRENT=4
PYTHON_MAX_OUTPUT_BYTES=4194304
