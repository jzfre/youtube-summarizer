# OpenAI API key (required)
OPENAI_API_KEY=your-openai-api-key-here

# Absolute paths to the Python CLI and interpreter (required)
PYTHON_CLI_PATH=/absolute/path/to/cli/youtube_summarizer.py
PYTHON_EXECUTABLE=/absolute/path/to/cli/venv/bin/python

# Shared password gating the web UI (required in production;
# defaults to "dev-password" in development)
APP_PASSWORD=pick-a-password

# Secret used to sign session cookies (required in production).
# Generate one with: openssl rand -hex 32
AUTH_SECRET=change-me-to-a-long-random-string
